# Contract addresses are not configured here: they live in lib/deployments.ts,
# next to the ABI that talks to them. Only secrets and tuning go in env vars.

# ---- required in production ----------------------------------------------

# The maker's quote signer. Must match makers(<maker>).signer on-chain.
QUOTER_PRIVATE_KEY=

# Hermes (Pyth) has required an API key since 26 Aug 2026. Settlement data and
# the Pyth spot price both need it. Get one at https://pythdata.app/signup
PYTH_API_KEY=

# ---- keeper ----------------------------------------------------------------

# Pays gas for the daily settlement run (vercel.json cron, 08:05 UTC).
# Needs a little GIWA Sepolia ETH and nothing else: settlement is permissionless.
# Falls back to QUOTER_PRIVATE_KEY when unset.
# KEEPER_PRIVATE_KEY=

# When set, Vercel Cron sends it and any other caller of /api/cron/settle only
# gets a dry run. Optional: settlement pays out at Pyth's price whoever calls it.
# CRON_SECRET=

# ---- site ------------------------------------------------------------------

# true is the pre-launch site: the splash at /, "Coming soon" on Earn and
# Portfolio, and only /early (early access) working. Everything is kept out of
# search. Read at build time: redeploy after changing it.
# COMING_SOON=true

# ---- early access (/early) -------------------------------------------------

# Postgres for the points list. On Vercel: Storage > Create > Neon, connected to
# this project, sets it for you. Without it, local dev uses an embedded
# Postgres in web/.data and production answers "not open yet".
# DATABASE_URL=
# Signs the sign-in cookie. Any random string of 32+ characters:
#   openssl rand -hex 32
# SESSION_SECRET=
# Opens /early/admin and the CSV export (Authorization: Bearer <token>).
# EARLY_ADMIN_TOKEN=
# "on" opens the "Write your first option" step. Leave off until the maker is funded.
# EARLY_TESTNET_QUEST=on
# The X steps and referrals run on one X developer app, created while signed in
# to X as @Writ_Fi (console.x.com), with pay-per-use credits and spending alerts.
# These four read as @Writ_Fi: the follow check (owned reads, $0.001 per follower)
# and post lookups (about $0.005 a post). Copy the app's API Key and Secret and
# generate the Access Token and Secret.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Followers read per UTC day by follow checks after the first full read
# (default 5000, about $5). Past it, checks wait for the next day.
# X_DAILY_READ_LIMIT=5000
# Sign in with X, which links a wallet to the X account its owner signs in to and
# reads the profile snapshot referrals are scored from (about $0.01 per sign-in).
# From the same app: User authentication settings > OAuth 2.0, Web App
# (confidential client), read only, with https://www.writ.fi/api/early/x/callback
# as a callback URL (add http://localhost:3222/api/early/x/callback to try it
# locally). Without these two, X accounts cannot be linked and referrals cannot
# qualify; with them but without the four keys above, the X steps stay closed.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# Only if the callback URL registered on X differs from <this site>/api/early/x/callback.
# X_REDIRECT_URI=

# ---- optional tuning -------------------------------------------------------

# RPC for server reads and the keeper (defaults to GIWA Flashblocks). For a local
# fork, also set NEXT_PUBLIC_RPC_URL so the browser uses the same chain.
# RPC_URL=
# NEXT_PUBLIC_RPC_URL=

# Implied vol comes from Deribit when reachable, the model otherwise.
# DERIBIT_URL=https://www.deribit.com
# Model surface, used as the fallback.
# VOL_ATM_SHORT=0.48
# VOL_ATM_LONG=0.45
# VOL_SKEW=0.08
# Maker spread below fair value.
# DESK_SPREAD=0.10
# QUOTE_TTL_SEC=20

# RFQ: extra maker endpoints (same shape as /api/quote), comma separated.
# MAKER_ENDPOINTS=
# RFQ_WINDOW_MS=2000

# Health warnings for the maker's free balances (USDC 1e6, BTC 1e8).
# LOW_LIQUIDITY_USDC=200000000
# LOW_LIQUIDITY_BTC=2000000
